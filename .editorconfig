root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,yml,yaml,md}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[eudamed-xml-generator.html]
# The application is one self-contained file; keep the existing 4-space style.
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
